# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Security & Authorization Keys
# TRITON_KEY: Secret key required for sensitive / administrative API mutations (POST /api/catalog, /api/delete-image, /api/seo/update-files)
TRITON_KEY=

# TRITON_DEBUG_UPLOADS: Optional debug toggle (non-production only).
# When set to "true" and NODE_ENV !== "production", API error responses include truncated WordPress response snippets in details.
# Use TRITON_DEBUG_UPLOADS=true and non-production NODE_ENV only for diagnostics; disable in production.
TRITON_DEBUG_UPLOADS=false

# CORS Configuration
# Comma-separated list of allowed origins in production mode (e.g., https://car-lifts.co.za,https://store.car-lifts.co.za)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://car-lifts.co.za,https://store.car-lifts.co.za,https://remix-templates2.vercel.app

# Vercel Environment Configuration
# For Vercel deployments, set these in Project Settings > Environment Variables
# NODE_ENV should be "production" for production environment
# VERCEL_ENV should be "production" for main branch
NODE_ENV=production
VERCEL_ENV=production

# WordPress REST API Integration
WP_BASE_URL=https://store.car-lifts.co.za
WP_APP_USER=
WP_APP_PASSWORD=
WP_AUTH_TOKEN=
WP_USER_AGENT=TritonShowroomSync/2.0 (sync@car-lifts.co.za)
WP_MIGRATE_KEY=
CF_BYPASS_SECRET=
VERCEL_SECRET=

# SMTP Mail Server Configuration (Optional for cPanel / custom SMTP)
SMTP_HOST=mail.car-lifts.co.za
SMTP_PORT=465
SMTP_USER=info@car-lifts.co.za
SMTP_PASS=
